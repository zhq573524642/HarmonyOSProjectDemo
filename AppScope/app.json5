{
  "app": {
    //设置应用中，需要展示应用列表时
    //在隐私管理中，需要展示应用申请的权限时
    //在状态栏显示通知消息时
    "bundleName": "com.zhq.harmonyosdemo",
    //bundleName包名
    "bundleType": "app",
    //app:应用（默认） atomicService:元服务 shared:共享库应用 appService:系统级共享应用
    "vendor": "张较瘦",
    //标识对应用开发厂商的描述
    "versionCode": 1000000,
    //版本code
    "versionName": "1.0.0",
    //版本名称
    "icon": "$media:app_icon",
    //应用图标
    "label": "$string:app_name",
    //应用名称
    "description": "这是应用描述啊啊啊",
    //应用描述

    //    "minCompatibleVersionCode": 1000,//标识应用能够兼容的最低历史版本号，用于应用多设备之间协同、数据迁移、跨设备兼容性判断，该字段为预留字段，暂未使用。
    //     "minAPIVersion": ,//标识应用运行需要的SDK的API最小版本
    //    "targetAPIVersion": ,//标识应用运行需要的API目标版本
    "configuration": "$profile:configuration",
    //应用分身
    "multiAppMode": {
      "multiAppModeType": "appClone",
      "maxCount": 3
    }
  }
}
